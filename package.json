{
  "name": "@capacitor-community/stripe",
  "version": "8.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "private": false,
  "description": "Stripe SDK bindings for Capacitor Applications",
  "scripts": {
    "release": "np --no-tests --no-publish --any-branch",
    "build": "npm run build --workspaces --if-present"
  },
  "workspaces": [
    "packages/identity",
    "packages/payment",
    "packages/terminal",
    "packages/billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capacitor-community/stripe.git"
  },
  "homepage": "https://docs.rdlabo.dev/projects/capacitor-stripe",
  "devDependencies": {
    "np": "^10.2.0",
    "write-pkg": "^6.0.0"
  },
  "overrides": {
    "external-editor": {
      "tmp": "^0.2.7"
    },
    "write-pkg": {
      "deepmerge-ts": "^8.0.2"
    },
    "ws@6": "^6.2.6"
  }
}
