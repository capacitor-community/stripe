{
  "name": "capacitor-stripe-demo-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Hono API for the Capacitor Stripe demos",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:check": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.121.0"
  }
}
